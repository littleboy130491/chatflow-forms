{
  "name": "littleboy130491/chatflow-forms",
  "description": "Private conversational WordPress forms",
  "type": "wordpress-plugin",
  "license": "GPL-3.0-or-later",
  "require": {
    "php": ">=8.1",
    "ext-openssl": "*",
    "matomo/device-detector": "^6.5",
    "openspout/openspout": "~4.25.0",
    "opis/json-schema": "^2.6",
    "woocommerce/action-scheduler": "^3.9",
    "yahnis-elsts/plugin-update-checker": "^5.6"
  },
  "require-dev": {
    "brianhenryie/strauss": "0.31.1",
    "damian-elenbaas/elementor-stubs": "3.31.0",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.1",
    "php-stubs/wordpress-stubs": "^6.8",
    "php-stubs/wp-cli-stubs": "^2.12",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^9.6",
    "squizlabs/php_codesniffer": "^3.13",
    "wp-coding-standards/wpcs": "^3.2",
    "yoast/phpunit-polyfills": "^2.0"
  },
  "autoload": { "psr-4": { "ChatFlow\\": "src/" } },
  "autoload-dev": { "psr-4": { "ChatFlow\\Tests\\": "tests/php/" } },
  "config": {
    "platform": { "php": "8.1.0" },
    "allow-plugins": { "dealerdirect/phpcodesniffer-composer-installer": true },
    "sort-packages": true
  },
  "extra": {
    "strauss": {
      "target_directory": "vendor-prefixed",
      "namespace_prefix": "ChatFlow\\Vendor\\",
      "classmap_prefix": "CFF_Vendor_",
      "constant_prefix": "CFF_VENDOR_",
      "packages": ["opis/json-schema", "matomo/device-detector", "yahnis-elsts/plugin-update-checker", "openspout/openspout"],
      "include_root_autoload": false,
      "update_call_sites": false,
      "exclude_from_copy": { "packages": ["woocommerce/action-scheduler"] }
    }
  },
  "scripts": {
    "scope": ["strauss", "@php tools/scope-puc.php", "@php tools/verify-scope.php"],
    "test": "phpunit",
    "analyse": "phpstan analyse --memory-limit=1G",
    "lint": "phpcs",
    "lint:fix": "phpcbf",
    "package": "@php tools/package.php"
  }
}
