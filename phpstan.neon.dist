parameters:
    level: 6
    paths:
        - src
    scanFiles:
        - vendor/php-stubs/wordpress-stubs/wordpress-stubs.php
        - tests/php/constants.php
        - tests/php/Backend/static-constants.php
        - vendor/php-stubs/wp-cli-stubs/wp-cli-stubs.php
        - vendor/damian-elenbaas/elementor-stubs/elementor-stubs.php
    scanDirectories:
        - vendor-prefixed
        - vendor/woocommerce/action-scheduler
    tmpDir: .phpstan-cache
