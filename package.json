{
  "name": "chatflow-forms",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.18 <25",
    "npm": ">=11.16"
  },
  "scripts": {
    "build": "npm run schema:types && npm run build:admin && npm run build:runtime",
    "build:admin": "wp-scripts build --config webpack.config.cjs",
    "build:runtime": "vite build && CFF_ENTRY=tracking vite build",
    "schema:types": "node tools/schema-types.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.runtime.json",
    "lint": "eslint assets/src tests/js tools/*.mjs",
    "test": "vitest run",
    "env:start": "node tools/wp-env.mjs start",
    "env:stop": "node tools/wp-env.mjs stop",
    "test:wp": "node tools/wp-env.mjs run tests-cli --env-cwd=wp-content/plugins/chatflow-forms php vendor/bin/phpunit -c phpunit.wp.xml.dist",
    "test:wp:multisite": "node tools/wp-env.mjs run tests-cli --env-cwd=wp-content/plugins/chatflow-forms env WP_MULTISITE=1 php vendor/bin/phpunit -c phpunit.wp.xml.dist",
    "package": "composer scope && php tools/package.php",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@xyflow/react": "12.10.1",
    "libphonenumber-js": "1.13.15",
    "preact": "10.29.8",
    "qrcode": "1.5.4"
  },
  "overrides": {
    "simple-git": "4.0.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.19.11",
    "@types/qrcode": "1.5.5",
    "@types/react": "18.3.28",
    "@typescript-eslint/eslint-plugin": "8.71.2",
    "@typescript-eslint/parser": "8.71.2",
    "@wordpress/api-fetch": "7.57.0",
    "@wordpress/block-editor": "18.1.0",
    "@wordpress/blocks": "16.2.0",
    "@wordpress/components": "42.0.0",
    "@wordpress/data": "10.57.0",
    "@wordpress/element": "9.0.0",
    "@wordpress/env": "11.17.0",
    "@wordpress/eslint-plugin": "26.0.0",
    "@wordpress/i18n": "6.30.0",
    "@wordpress/scripts": "35.0.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "9.39.5",
    "globals": "16.4.0",
    "jsdom": "26.1.0",
    "json-schema-to-typescript": "15.0.4",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "4.1.11"
  }
}
